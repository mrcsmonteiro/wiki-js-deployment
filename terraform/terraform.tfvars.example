# Copy to terraform.tfvars (git-ignored) and fill in the required values.

# Required
account_id                   = "<workload-account-id>"
existing_acm_certificate_arn = "arn:aws:acm:us-east-1:<workload-account-id>:certificate/<certificate-id>"

# Optional overrides (defaults in variables.tf)
# aws_profile = "marcosms-prod-admin"   # resource provisioning; state uses deployments-admin via backend-prod.hcl
# aws_region  = "ap-southeast-2"
# domain_name = "wiki.marcosms.com.au"
