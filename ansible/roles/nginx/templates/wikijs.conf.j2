# Wiki.js vhost. Managed by Ansible (wiki-js-deployment).
#
# default_server matters: CloudFront sends origin requests with a Host header
# that is not the wiki name. Without default_server, another vhost on port 80
# would receive them. Other vhosts on this host must match by server_name.
# Only CloudFront reaches this server (the security group allows its
# origin-facing prefix list). CloudFront appends the viewer's address to
# X-Forwarded-For, so the last entry is the real client and anything before it
# is whatever the client sent. Pass only that last entry on, so Wiki.js can
# trust the header (security.trustProxy) without it being spoofable.
map $http_x_forwarded_for $wikijs_client_ip {
    "~(?<last>[^,\s]+)\s*$" $last;
    default                  $remote_addr;
}

server {
    listen 80 default_server;
    server_name {{ wikijs_domain }};

    # Uploads and large POSTs (page saves, setup).
    client_max_body_size 50M;

{% if wikijs_root_redirect %}
    # Wiki.js 3 serves "/" from its own root page; the home page lives at
    # {{ wikijs_root_redirect }} (where Wiki.js 2.x served it from "/").
    location = / {
        absolute_redirect off;
        return 302 {{ wikijs_root_redirect }};
    }

{% endif %}
    location / {
        proxy_pass http://127.0.0.1:{{ wikijs_port }};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $wikijs_client_ip;
        proxy_set_header X-Forwarded-For $wikijs_client_ip;
        # Viewers always reach CloudFront over HTTPS (redirect-to-https); only the
        # CloudFront-to-host hop is HTTP. Wiki.js builds absolute URLs, such as
        # the SAML callback, from this.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl on;
        proxy_set_header X-Forwarded-Host $host;

        # WebSockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_buffering off;
        proxy_read_timeout 900s;

        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Length $content_length;

        # Keep Wiki.js redirects as Wiki.js sends them.
        proxy_redirect off;
    }
}
