[Unit]
Description=Nightly Wiki.js and PCA backups to S3
Requires=docker.service
After=docker.service wikijs.service
RequiresMountsFor={{ backup_dir }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wikijs-backup
TimeoutStartSec=900
# Also written to a file, which the CloudWatch agent ships to CloudWatch Logs.
StandardOutput=append:{{ backup_log }}
StandardError=append:{{ backup_log }}
